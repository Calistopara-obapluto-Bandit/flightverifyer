# Neon Postgres connection string (Project → Connect → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Inbox that receives support requests
SUPPORT_EMAIL=support.sbiamautos@gmail.com

# Option A (no account needed): HTTPS mail relay, used when RESEND_API_KEY is empty.
# Defaults to https://formsubmit.co/ajax/<SUPPORT_EMAIL>. Activate it once via the
# email formsubmit.co sends. Set to "off" to disable the relay.
# SUPPORT_FORM_ENDPOINT=https://formsubmit.co/ajax/support.sbiamautos@gmail.com

# Option B: Resend → API Keys (takes precedence when set)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPPORT_FROM=flightverifyer desk <onboarding@resend.dev>

# Admin console credentials (change before deploying)
ADMIN_EMAIL=admin@verifymyflight.local
ADMIN_PASSWORD=verify-admin-2026
