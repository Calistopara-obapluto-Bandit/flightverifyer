# Neon Postgres connection string (Project → Connect → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Inbox(es) that receive support requests — comma-separated for more than one
SUPPORT_EMAIL=support.sbiamautos@gmail.com

# Option A (recommended): Brevo → SMTP & API → API Keys.
# Sign up with SUPPORT_EMAIL, verify that address as a sender (one click, no
# domain needed), then paste the key. Free plan sends 300 emails a day over
# HTTPS, which Render's free tier allows.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address; defaults to the first SUPPORT_EMAIL
# BREVO_SENDER=support.sbiamautos@gmail.com
# BREVO_SENDER_NAME=AiroPack desk

# Option B: Resend → API Keys (used when BREVO_API_KEY is empty)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPPORT_FROM=airopack desk <onboarding@resend.dev>

# Option C (no account needed): HTTPS mail relay, used when neither key is set.
# Defaults to https://formsubmit.co/ajax/<SUPPORT_EMAIL>. Activate it once via the
# email formsubmit.co sends. Set to "off" to disable the relay.
# SUPPORT_FORM_ENDPOINT=https://formsubmit.co/ajax/support.sbiamautos@gmail.com
# Page origin presented to the relay (must look like a served page, not a file)
# SUPPORT_FORM_ORIGIN=https://flightverifyer.onrender.com

# Admin console credentials (change before deploying)
ADMIN_EMAIL=admin@verifymyflight.local
ADMIN_PASSWORD=verify-admin-2026
